{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/master/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE\\applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 3,
  "default_container_padding": 3,
  "mouse_follows_focus": false,
  "transparency": false,
  "transparency_alpha": 192,
  "animation": {
    "enabled": true,
    "duration": 120,
    "style": "EaseInOutCubic",
    "fps": 60
  },
  "border": false,
  "border_implementation": "Windows",
  "border_style": "System",
  "border_width": 0,
  "border_offset": 0,
  "border_colours": {
    "single": "#00000080",
    "stack": "#00000080",
    "monocle": "#00000080",
    "unfocused": "#00000080",
    "floating": "#00000080"
  },
  "stackbar": {
    "mode": "Never"
  },
  "ignore_rules": [
    { "kind": "Exe", "id": "Steam.exe", "matching_strategy": "Equals" },
    {
      "kind": "Exe",
      "id": "Minecraft.Windows.exe",
      "matching_strategy": "Equals",
      "float": true
    },
    { "kind": "Exe", "id": "Flow.Launcher.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "Fluver.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "Xbox.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "Windhawk.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "vlc.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "SnippingTool.exe", "matching_strategy": "Equals" },
    {
      "kind": "Exe",
      "id": "ApplicationFrameHost.exe",
      "matching_strategy": "Equals"
    },
    { "kind": "Exe", "id": "yasb.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "python3.12.exe", "matching_strategy": "Equals" },
    {
      "kind": "Exe",
      "id": "WindowsTerminal.exe",
      "matching_strategy": "Equals"
    },
    { "kind": "Exe", "id": "setup.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "installer.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "unins000.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "update.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "msiexec.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "bootstrapper.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "autoupdate.exe", "matching_strategy": "Equals" },
    { "kind": "Title", "id": "Setup", "matching_strategy": "Equals" },
    { "kind": "Title", "id": "Installer", "matching_strategy": "Equals" },
    { "kind": "Title", "id": "Installation", "matching_strategy": "Equals" },
    { "kind": "Title", "id": "Wizard", "matching_strategy": "Equals" },
    { "kind": "Title", "id": "Update", "matching_strategy": "Equals" }
  ],
  "manage_rules": [
    {
      "kind": "Exe",
      "id": "LeagueClientUx.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "RiotClientServices.exe",
      "matching_strategy": "Equals"
    }
  ],
  "floating_applications": [
    {
      "kind": "Exe",
      "id": "LeagueClientUx.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "RiotClientServices.exe",
      "matching_strategy": "Equals"
    }
  ],
  "monitors": [
    {
      "workspaces": [
        {
          "name": "1",
          "layout": "Columns",
          "layout_rules": {
            "3": "Scrolling"
          },
          "layout_options": {
            "scrolling": {
              "columns": 2,
              "center_focused_column": false
            }
          }
        },
        {
          "name": "2",
          "layout": "Columns",
          "layout_rules": {
            "3": "Scrolling"
          },
          "layout_options": {
            "scrolling": {
              "columns": 2,
              "center_focused_column": false
            }
          }
        },
        {
          "name": "3",
          "layout": "Columns",
          "layout_rules": {
            "3": "Scrolling"
          },
          "layout_options": {
            "scrolling": {
              "columns": 2,
              "center_focused_column": false
            }
          }
        },
        {
          "name": "4",
          "layout": "Columns",
          "layout_rules": {
            "3": "Scrolling"
          },
          "layout_options": {
            "scrolling": {
              "columns": 2,
              "center_focused_column": false
            }
          }
        },
        {
          "name": "5",
          "layout": "Columns",
          "layout_rules": {
            "3": "Scrolling"
          },
          "layout_options": {
            "scrolling": {
              "columns": 2,
              "center_focused_column": false
            }
          }
        }
      ]
    }
  ]
}
